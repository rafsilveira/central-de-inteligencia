# 1. N8N (Automação Base)
N8N_WEBHOOK_URL="https://seu-dominio.com/webhook/"
N8N_API_KEY="sua_chave_api_n8n_aqui"

# 2. CRM (Ex: Kommo, HubSpot, etc)
CRM_API_URL="https://sua-empresa.kommo.com/api/v4/"
CRM_ACCESS_TOKEN="seu_token_de_acesso_longo_aqui"
CRM_PIPELINE_ID="id_do_funil_principal"

# 3. Tráfego Pago (Meta & Google Ads)
META_ACCESS_TOKEN="seu_token_de_usuario_do_sistema_meta"
META_AD_ACCOUNT_ID="act_123456789"
META_APP_ID="id_do_app_meta"
META_PIXEL_ID="id_do_pixel_meta"
GOOGLE_ADS_DEVELOPER_TOKEN="seu_developer_token_google_aqui"
GOOGLE_ADS_CLIENT_CUSTOMER_ID="123-456-7890"
GOOGLE_ADS_CLIENT_ID="id_do_cliente_oauth.apps.googleusercontent.com"
GOOGLE_ADS_CLIENT_SECRET="chave_secreta_do_cliente_oauth"
GOOGLE_ADS_REFRESH_TOKEN="refresh_token_gerado_na_autorizacao"

# 4. Agentes Inteligentes
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIza..."
